  {
    "id": "fn_evento",
    "type": "function",
    "z": "tab_comedero",
    "name": "guardar evento",
    "func": "\n// Guarda el ultimo evento y lleva un registro corto para el tablero.\nvar registro = flow.get(\"registro\") || [];\nvar tipo = (msg.topic || \"\").split(\"/\").pop();\n\nregistro.unshift({ tipo: tipo, datos: msg.payload, cuando: Date.now() });\nflow.set(\"registro\", registro.slice(0, 12));\nflow.set(\"ultimo\", { tipo: tipo, datos: msg.payload, cuando: Date.now() });\n\nreturn null;\n",
    "outputs": 0,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 80,
    "wires": []
  },

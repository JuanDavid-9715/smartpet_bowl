	(text "Placa Freenove ESP32-S3-WROOM CAM. Pinout del PDF oficial: 20 pines por borne."
		(exclude_from_sim no)
		(at 45 30.48 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "93085952-d6ed-4844-bfdc-79b9df5ef253")
	)
	(text "GPIO35, 36 y 37 son el PSRAM del modulo: no se cablean."
		(exclude_from_sim no)
		(at 45 39.37 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "241d71ff-b59d-40cf-a5d0-df57d4ce48b8")
	)
	(text "GPIO38, 39 y 40 son tambien SD_CMD, SD_CLK y SD_DATA: no se puede usar la tarjeta SD."
		(exclude_from_sim no)
		(at 45 48.26 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "ae45bae6-a216-4a1d-8a06-23b7606a63c1")
	)
	(text "IN2 del L298N va a GPIO38. IN1 a GPIO14. ENA queda con el jumper a 5 V."
		(exclude_from_sim no)
		(at 45 57.15 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "f1e506de-d9c5-4a4d-87ae-0f2369e220c4")
	)
	(text "Solo se usa el canal A del L298N: OUT1 y OUT2 mueven el tornillo sin fin."
		(exclude_from_sim no)
		(at 45 66.04 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "dbd90dca-d99a-4bdc-b5f4-99a4078e94db")
	)
	(text "HX711 a 3V3 para que DT no pase de 3.6 V en GPIO40. A 5 V hace falta un divisor."
		(exclude_from_sim no)
		(at 45 74.93 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "6d4f4e4b-4ed7-40bc-88e4-89fbfbb10360")
	)
	(text "GPIO1 es SCL y GPIO2 es SDA del VL53L0X. XSHUT (GPIO41) debe quedar en alto."
		(exclude_from_sim no)
		(at 45 83.82 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "b14f3fb9-8f71-4816-8dc1-5f6c6baaf631")
	)
	(text "C1 absorbe el pico del motor en 12 V y C2 el del servo en 5 V. GND comun a todo."
		(exclude_from_sim no)
		(at 45 92.71 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "8e875763-bda9-49f7-b98b-ba18b0120491")
	)

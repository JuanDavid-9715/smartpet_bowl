	(text "IN2 no puede quedar al aire: el puente queda indefinido y el motor no gira. Va a GPIO48."
		(exclude_from_sim no)
		(at 45 57.15 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "ff718bbe-d7b3-4ba6-af93-8ddea25c9191")
	)
	(text "El pin 3V3 no se cablea: lo genera la propia placa desde 5 V. Igual el 3V3 del FPC de la camara."
		(exclude_from_sim no)
		(at 45 64.77 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "0935d4f8-1c92-468c-85af-82ec3796c45b")
	)
	(text "GPIO35, 36 y 37 son el PSRAM del modulo: no se cablean."
		(exclude_from_sim no)
		(at 45 72.39 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "c207eece-5f2a-4715-b686-df0d7cdf531b")
	)
	(text "GPIO38, 39 y 40 son tambien SD_CMD, SD_CLK y SD_DATA: no se puede usar la tarjeta SD."
		(exclude_from_sim no)
		(at 45 81.28 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "aa3687ee-68e4-4ee9-8e1a-748951fa6fcc")
	)
	(text "ENA y ENB quedan con el jumper puesto: el motor gira a tope."
		(exclude_from_sim no)
		(at 45 88.9 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "9db8a7b8-3199-4eb6-967b-7807bf9afdbf")
	)
	(text "Solo se usa el canal A del L298N: OUT1 y OUT2 mueven el tornillo sin fin."
		(exclude_from_sim no)
		(at 45 96.52 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "632d5c07-f41b-424c-8817-6c44a2d27a21")
	)
	(text "DT del HX711 va directo a GPIO40 con 5 V. El maximo del pin es 3.6 V: sin divisor queda fuera de especificacion."
		(exclude_from_sim no)
		(at 45 105.41 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "7ff2c0dd-eaf1-4820-aab8-03f904cfee92")
	)
	(text "SCL del VL53L0X a GPIO1 y SDA a GPIO2. XSHUT (GPIO41) en alto o el sensor no arranca."
		(exclude_from_sim no)
		(at 45 113.03 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "ad59b15a-4805-49e7-bd83-cd4ee64134e3")
	)
	(text "GPIO48 comparte pin con el LED WS2812 de la placa: el LED puede parpadear al mover el motor."
		(exclude_from_sim no)
		(at 45 120.65 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "5f9f8e9f-91ae-4a9f-b6d8-cad58688adab")
	)
	(text "SG90: 220 mA en movimiento y hasta 650 mA en bloqueo. Un puerto USB da 500 mA."
		(exclude_from_sim no)
		(at 45 129.54 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "50ed3344-c20e-4908-a2eb-0a24ec2c672b")
	)
	(text "C1 filtra el pico del motor en 12 V y C2 el del servo en 5 V. GND comun a todo."
		(exclude_from_sim no)
		(at 45 137.16 0)
		(effects (font (size 1.55 1.55)) (justify left bottom))
		(uuid "143559b6-3de9-4a4c-aef0-a80ada949958")
	)
